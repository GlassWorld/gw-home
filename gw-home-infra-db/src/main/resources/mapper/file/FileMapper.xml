<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gw.infra.db.mapper.file.FileMapper">

    <insert id="insertFile" parameterType="FileVo" useGeneratedKeys="true" keyProperty="idx">
        INSERT INTO tb_file (
            orgnl_nm,
            strg_nm,
            file_path,
            file_url,
            mime_type,
            file_size,
            upldr_type,
            created_by
        ) VALUES (
            #{orgnlNm},
            #{strgNm},
            #{filePath},
            #{fileUrl},
            #{mimeType},
            #{fileSize},
            #{upldrType},
            #{createdBy}
        )
    </insert>

    <!-- 파일 조회의 공통 컬럼을 정의한다. -->
    <sql id="fileSelect">
        SELECT
            file_idx AS idx,
            file_uuid AS uuid,
            orgnl_nm,
            strg_nm,
            file_path,
            file_url,
            mime_type,
            file_size,
            upldr_type,
            created_by,
            created_at,
            del_at
        FROM tb_file
    </sql>

    <!-- 첨부 검증에 필요한 삭제되지 않은 파일들을 일괄 조회한다. -->
    <select id="selectFilesByUuids" resultType="FileVo">
        <include refid="fileSelect"/>
        WHERE del_at IS NULL
        <choose>
            <when test="uuids != null and !uuids.isEmpty()">
                AND file_uuid IN
                <foreach collection="uuids" item="uuid" open="(" separator="," close=")">
                    CAST(#{uuid} AS UUID)
                </foreach>
            </when>
            <otherwise>AND 1 = 0</otherwise>
        </choose>
    </select>

    <select id="selectFileByUuid" resultType="FileVo">
        <include refid="fileSelect"/>
        WHERE file_uuid = CAST(#{uuid} AS UUID)
    </select>

    <select id="selectFileByIdx" resultType="FileVo">
        <include refid="fileSelect"/>
        WHERE file_idx = #{idx}
    </select>

    <update id="deleteFile">
        UPDATE tb_file
        SET del_at = now()
        WHERE file_uuid = CAST(#{uuid} AS UUID)
          AND del_at IS NULL
    </update>

</mapper>
